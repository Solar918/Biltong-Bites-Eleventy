---
layout: layouts/base.njk
title: Admin Dashboard
description: Manage Biltong Bites Customers and Orders
---

<article class="container admin-page">
  <header class="admin-header">
    <div>
      <h1>Admin Dashboard</h1>
      <p class="admin-subtitle">Monitor orders, customer details, and order statuses in real-time.</p>
    </div>
    <div class="admin-view-controls">
      <a href="/account/" class="btn btn-ghost">← My Account</a>
      <button class="btn" id="view-combined">Combined</button>
      <button class="btn btn-ghost" id="view-orders">Orders Only</button>
      <button class="btn btn-ghost" id="view-customers">Customers</button>
      <button class="btn btn-danger" id="reset-orders-btn">Reset All Orders</button>
    </div>
  </header>

  <div class="admin-filter-bar">
    <div class="filter-field">
      <label for="filter-customer">Filter by Customer</label>
      <select id="filter-customer">
        <option value="">All Customers</option>
      </select>
    </div>
    <div class="filter-field">
      <label for="filter-product">Filter by Product</label>
      <input type="search" id="filter-product" placeholder="Type product name (e.g. 100g, 50g)..." />
    </div>
  </div>

  <div id="admin-content">
    <!-- Rendered via admin.js -->
    <div class="admin-loading"><p>Loading dashboard metrics...</p></div>
  </div>
</article>

<script src="/assets/scripts/admin.js"></script>
