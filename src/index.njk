---
layout: layouts/base.njk
title: Premium Handcrafted Biltong
---

<!-- Hero Section -->
<section class="hero container" aria-labelledby="intro-heading">
  <div class="hero-content">
    <div class="hero-badge">
      <span class="hero-badge-dot"></span> 100% NZ Crafted Beef Biltong · Young Enterprise Scheme
    </div>
    <h1 id="intro-heading">Handcrafted. Tender. <br><span class="text-accent">Biltong Bites.</span></h1>
    <p class="lead">Artisanal, nutrient-dense biltong hand-made in Auckland using low-stress beef for superior tenderness and less acidity. Quality you can taste in every single bite.</p>
    
    <div class="cta">
      <a href="#products" class="btn">Shop Our Range</a>
      <a href="#about" class="btn btn-ghost">Our Story</a>
    </div>

    <!-- Value Propositions -->
    <div class="usp-icons">
      <div class="usp-item">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
        <span>High Protein</span>
      </div>
      <div class="usp-item">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.42 4.58a5.4 5.4 0 0 0-7.65 0l-.77.78-.77-.78a5.4 5.4 0 0 0-7.65 0C1.46 6.7 1.33 10.28 4 13l8 8 8-8c2.67-2.72 2.54-6.3.42-8.42z"/></svg>
        <span>Low-Stress Beef</span>
      </div>
      <div class="usp-item">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
        <span>Artisanal Quality</span>
      </div>
    </div>
  </div>
</section>

<!-- Products Section -->
<section id="products" class="container section" aria-labelledby="products-heading">
  <header class="section-header">
    <div>
      <h2 id="products-heading">Our Products</h2>
      <p class="section-subheading">Choose your pack size, freshly spiced and naturally cured.</p>
    </div>

    <div class="controls">
      <label class="search" for="product-search">
        <span class="visually-hidden">Search products</span>
        <input id="product-search" type="search" placeholder="Search products…" autocomplete="off" />
      </label>

      <div class="filter-dropdown">
        <button class="filter-toggle" id="filter-btn" aria-haspopup="true" aria-expanded="false">
          <span>Filters</span>
          <span class="filter-arrow" aria-hidden="true">▾</span>
        </button>
        <div class="filter-menu" role="menu">
          <div class="filter-column">
            <span class="filter-heading">Flavour</span>
            <div class="filter-group" id="flavour-filters">
              {% for t in collections.flavourTags %}
                <label><input type="checkbox" value="{{ t | lower }}" /> <span>{{ t }}</span></label>
              {% endfor %}
            </div>
          </div>
          <div class="filter-column">
            <span class="filter-heading">Quantity</span>
            <div class="filter-group" id="quantity-filters">
              {% for t in collections.quantityTags %}
                <label><input type="checkbox" value="{{ t | lower }}" /> <span>{{ t }}</span></label>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <div class="grid products" id="product-grid">
    {% for product in collections.products %}
      {% include "components/product-card.njk" %}
    {% endfor %}
  </div>

  <div id="no-products-message" class="empty-state" style="display: none;">
    <p>No products match your current filters.</p>
    <button type="button" class="btn btn-ghost" id="clear-filters-btn">Clear All Filters</button>
  </div>
</section>

<!-- About Section -->
<section id="about" class="container section" aria-labelledby="about-heading">
  <div class="about-card">
    <div class="about-content">
      <span class="section-tag">Young Enterprise Scheme</span>
      <h2 id="about-heading">Our Story</h2>
      <p>
        We’re a team of four passionate 15 and 16-year-old student founders from Long Bay College in Auckland running <strong>Biltong Bites</strong> as part of the Young Enterprise Scheme (YES).
      </p>
      <p>
        Unlike mass-produced jerky, we handcraft our biltong using carefully selected, low-stress meat. This thoughtful curing method yields pieces that are naturally more tender, less acidic, and richer in wholesome flavor.
      </p>
      <p>
        Driven by teamwork, passion, and high standards, we take pride in delivering a clean, high-protein snack made right here by the next generation of Kiwi entrepreneurs.
      </p>
      <div class="about-stats">
        <div class="stat-box">
          <span class="stat-number">4</span>
          <span class="stat-label">Student Founders</span>
        </div>
        <div class="stat-box">
          <span class="stat-number">100%</span>
          <span class="stat-label">NZ Handcrafted</span>
        </div>
        <div class="stat-box">
          <span class="stat-number">High</span>
          <span class="stat-label">Natural Protein</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Contact Section -->
<section id="contact" class="container section" aria-labelledby="contact-heading">
  <div class="contact-wrapper">
    <div class="contact-info">
      <h2 id="contact-heading">Get in Touch</h2>
      <p>Have questions about bulk orders, school pickups, or our curing process? We'd love to hear from you!</p>
      <p class="contact-email">
        <strong>Direct Email:</strong><br>
        <a href="mailto:{{ site.author.email }}">{{ site.author.email }}</a>
      </p>
      <p class="contact-pickup">
        <strong>Pickup Location:</strong><br>
        Long Bay College, Auckland 0630
      </p>
    </div>

    <div class="contact-form-box">
      <form id="contact-form">
        <div class="form-row">
          <label>
            <span>Your Name</span>
            <input required name="name" type="text" placeholder="e.g. John Doe" autocomplete="name" />
          </label>
          <label>
            <span>Your Email</span>
            <input required type="email" name="email" placeholder="e.g. john@example.com" autocomplete="email" />
          </label>
        </div>
        <label>
          <span>Message</span>
          <textarea required name="message" rows="5" placeholder="How can we help you?"></textarea>
        </label>
        <button class="btn" type="submit">Send Message</button>
      </form>
      <div id="contact-result" style="margin-top: 1rem;"></div>
    </div>
  </div>
</section>
