---
layout: layouts/base.njk
title: The Heritage Art of South African Air-Curing
description: 100% Pasture-Raised Prime Beef, slow air-cured with coarse roasted coriander and vinegar. Zero added sugar, strictly Kosher certified, 52g protein per 100g.
---

<!-- ========================================================================= -->
<!-- B. SENSORY HOMEPAGE HERO SECTION                                         -->
<!-- ========================================================================= -->
<section class="relative overflow-hidden pt-12 pb-16 md:pt-20 md:pb-24 border-b border-brand-border bg-gradient-to-b from-[#FAF7F2] to-parchment">
  <div class="absolute -right-20 -top-20 w-96 h-96 rounded-full bg-paprika/5 blur-3xl pointer-events-none"></div>
  <div class="absolute -left-20 bottom-0 w-80 h-80 rounded-full bg-olive/5 blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-center">
      
      <!-- Left Column: Copy & Value Architecture -->
      <div class="lg:col-span-6 xl:col-span-7 flex flex-col justify-center">
        
        <!-- Eyebrow Tag -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-micro bg-olive/10 border border-olive/20 text-olive text-xs font-semibold tracking-wider uppercase mb-5 w-fit">
          <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          <span>100% Pasture-Raised • Naturally Air-Cured</span>
        </div>

        <!-- Headline (Classic Serif, Mixed Title Case) -->
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-dark leading-[1.12] mb-6">
          The Heritage Art of South African Air-Curing.
        </h1>

        <!-- Subtext -->
        <p class="text-base sm:text-lg text-slate-dark/80 leading-relaxed max-w-xl mb-8">
          Slowly air-cured prime beef tumbled with toasted whole coriander, sea salt, and vinegar. 
          <span class="font-semibold text-slate-dark">52g of bioavailable protein</span>, zero heat shortcuts, and zero added sugar.
        </p>

        <!-- Dual Call-to-Action Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-8">
          <a href="#products-collection" class="inline-flex justify-center items-center px-8 py-4 bg-paprika hover:bg-paprika-hover text-white font-medium text-base rounded-micro shadow-card transition-all duration-200 text-center">
            Shop Best Sellers
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
          <a href="#pdp-interactive" class="inline-flex justify-center items-center px-7 py-4 bg-transparent hover:bg-white text-slate-dark border border-slate-dark font-medium text-base rounded-micro transition-all duration-200 text-center">
            Build a Custom Taster Box
          </a>
        </div>

        <!-- Micro Trust Card -->
        <div class="inline-flex items-center gap-3 p-3 bg-white rounded-micro border border-brand-border w-fit shadow-subtle">
          <div class="flex text-amber-500">
            ★★★★★
          </div>
          <div class="text-xs font-semibold text-slate-dark">
            <span>Rated 4.9/5 by 1,400+ Biltong Enthusiasts</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Tactile High-Impact Meat Showcase Graphic -->
      <div class="lg:col-span-6 xl:col-span-5">
        <div class="relative rounded-micro border border-brand-border bg-white p-3 shadow-card overflow-hidden">
          
          <div class="relative w-full aspect-[4/3] rounded-micro overflow-hidden bg-[#2D1B16] flex items-center justify-center">
            <svg class="w-full h-full object-cover" viewBox="0 0 600 450" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Cross-sectional cuts of dry-cured biltong with roasted coriander rub">
              <defs>
                <linearGradient id="meatGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#3A1713"/>
                  <stop offset="40%" stop-color="#5C1F1A"/>
                  <stop offset="60%" stop-color="#842820"/>
                  <stop offset="85%" stop-color="#4B1612"/>
                  <stop offset="100%" stop-color="#240D0A"/>
                </linearGradient>
                <radialGradient id="centerJuice" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#B23C2C" stop-opacity="0.9"/>
                  <stop offset="70%" stop-color="#72211A" stop-opacity="0.6"/>
                  <stop offset="100%" stop-color="#3A1310" stop-opacity="0"/>
                </radialGradient>
                <pattern id="spiceRub" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
                  <circle cx="8" cy="8" r="2.5" fill="#D4AF37" opacity="0.8"/>
                  <circle cx="28" cy="14" r="3" fill="#A47E29" opacity="0.9"/>
                  <circle cx="16" cy="32" r="1.8" fill="#F4EDE0" opacity="0.75"/>
                  <circle cx="34" cy="30" r="2.2" fill="#D4AF37" opacity="0.85"/>
                  <circle cx="20" cy="20" r="1.2" fill="#1C1B1A" opacity="0.9"/>
                </pattern>
              </defs>
              <rect width="600" height="450" fill="#1E1614"/>
              <path d="M40 70 Q 300 40 560 70 L 580 390 Q 300 410 20 390 Z" fill="url(#meatGrad)"/>
              <ellipse cx="300" cy="225" rx="220" ry="120" fill="url(#centerJuice)"/>
              <path d="M90 140 Q 230 180 320 150 T 520 160" stroke="#F5EDE4" stroke-width="4" stroke-linecap="round" opacity="0.6"/>
              <path d="M120 220 Q 260 270 380 230 T 500 240" stroke="#FAF5EF" stroke-width="6" stroke-linecap="round" opacity="0.7"/>
              <path d="M70 300 Q 220 340 340 310 T 530 320" stroke="#EFE6DC" stroke-width="5" stroke-linecap="round" opacity="0.55"/>
              <rect x="30" y="60" width="540" height="340" fill="url(#spiceRub)"/>
            </svg>

            <!-- Live Callout Badges over imagery -->
            <div class="absolute top-4 left-4 bg-slate-dark/90 text-white backdrop-blur px-3 py-1.5 rounded-micro text-xs font-semibold tracking-wide border border-white/10 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-paprika"></span>
              Visible Moisture Gradient
            </div>
            <div class="absolute bottom-4 right-4 bg-white/95 text-slate-dark px-3 py-1.5 rounded-micro text-xs font-bold border border-brand-border shadow-sm">
              Toasted Coriander &amp; Sea Salt Rub
            </div>
          </div>

          <!-- Specifications bar -->
          <div class="mt-3 p-3 bg-parchment rounded-micro border border-brand-border flex items-center justify-between text-xs">
            <div class="flex items-center gap-2">
              <span class="font-bold text-slate-dark">Batch Traceability:</span>
              <span class="text-slate-dark/70">Hereford Prime Beef #UK-094</span>
            </div>
            <div class="text-olive font-semibold flex items-center gap-1">
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"/></svg>
              Glatt Kosher Certified
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<!-- ========================================================================= -->
<!-- C. TRUST & NUTRITIONAL STRIP                                              -->
<!-- ========================================================================= -->
<section class="bg-white border-b border-brand-border py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
      
      <div class="flex items-start gap-4 p-4 rounded-micro bg-parchment/60 border border-brand-border/70 hover:border-brand-border transition">
        <div class="w-10 h-10 rounded-micro bg-olive/10 text-olive flex items-center justify-center flex-shrink-0 font-bold">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div>
          <h2 class="text-sm font-bold text-slate-dark mb-1">Zero Added Sugar / Low Carb</h2>
          <p class="text-xs text-slate-dark/70 leading-relaxed">Keto &amp; Carnivore friendly whole-food fuel with zero corn syrups or dextrose.</p>
        </div>
      </div>

      <div class="flex items-start gap-4 p-4 rounded-micro bg-parchment/60 border border-brand-border/70 hover:border-brand-border transition">
        <div class="w-10 h-10 rounded-micro bg-paprika/10 text-paprika flex items-center justify-center flex-shrink-0 font-bold">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5"/>
          </svg>
        </div>
        <div>
          <h2 class="text-sm font-bold text-slate-dark mb-1">Air-Cured, Never Cooked</h2>
          <p class="text-xs text-slate-dark/70 leading-relaxed">Dried over days at ambient airflow, keeping natural enzymes and amino profiles intact.</p>
        </div>
      </div>

      <div class="flex items-start gap-4 p-4 rounded-micro bg-parchment/60 border border-brand-border/70 hover:border-brand-border transition">
        <div class="w-10 h-10 rounded-micro bg-slate-dark/10 text-slate-dark flex items-center justify-center flex-shrink-0 font-bold">
          <span class="text-xs font-extrabold tracking-tighter">52g+</span>
        </div>
        <div>
          <h2 class="text-sm font-bold text-slate-dark mb-1">50g+ Protein per 100g</h2>
          <p class="text-xs text-slate-dark/70 leading-relaxed">Double the natural protein density of industrial heat-blasted commercial jerky.</p>
        </div>
      </div>

      <div class="flex items-start gap-4 p-4 rounded-micro bg-parchment/60 border border-brand-border/70 hover:border-brand-border transition">
        <div class="w-10 h-10 rounded-micro bg-amber-500/10 text-amber-700 flex items-center justify-center flex-shrink-0 font-bold">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
        </div>
        <div>
          <h2 class="text-sm font-bold text-slate-dark mb-1">Strictly Certified Kosher</h2>
          <p class="text-xs text-slate-dark/70 leading-relaxed">Supervised grass-fed sourcing, hygienic processing, and total batch traceability.</p>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ========================================================================= -->
<!-- D. FEATURED COLLECTION GRID (CRO PRODUCT CARDS)                           -->
<!-- ========================================================================= -->
<section id="products-collection" class="py-16 md:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
  <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-10 gap-4">
    <div>
      <div class="text-xs font-bold uppercase tracking-widest text-olive mb-2">Artisanal Butcher Cures</div>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-dark">Prime Cured Charcuterie</h2>
      <p class="text-slate-dark/70 text-sm mt-1">Hand-carved and seasoned with heritage South African spice formulas.</p>
    </div>

    <!-- Search & Filter Bar -->
    <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
      <div class="relative flex-1 md:w-64">
        <input id="product-search" type="search" placeholder="Filter cuts or sizes..." class="w-full bg-white border border-brand-border px-3.5 py-2 rounded-micro text-xs focus:outline-none focus:border-paprika shadow-sm" />
      </div>

      <select id="product-sort" class="bg-white border border-brand-border px-3 py-2 rounded-micro text-xs font-medium text-slate-dark focus:outline-none focus:border-paprika shadow-sm">
        <option value="default">Sort: Default</option>
        <option value="popularity">Popularity (Best Sellers)</option>
        <option value="price-asc">Price: Low to High</option>
        <option value="price-desc">Price: High to Low</option>
      </select>
    </div>
  </div>

  <!-- Dynamic Product Grid from Eleventy Collections -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8" id="product-grid">
    {% for product in collections.products %}
      {% include "components/product-card.njk" %}
    {% endfor %}
  </div>

  <div id="no-products-message" class="hidden text-center py-12 bg-white rounded-micro border border-brand-border mt-8">
    <p class="font-serif text-lg text-slate-dark mb-2">No matching products found</p>
    <button type="button" id="clear-filters-btn" class="text-xs font-bold text-paprika underline">Clear search filter</button>
  </div>
</section>

<!-- ========================================================================= -->
<!-- E. THE EDUCATIONAL "BILTONG VS. INDUSTRIAL JERKY" COMPARISON TABLE        -->
<!-- ========================================================================= -->
<section id="comparison-table" class="py-16 md:py-20 bg-white border-y border-brand-border">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-xs font-bold uppercase tracking-widest text-paprika mb-2 block">Uncompromising Nutrition</span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-dark mb-4">Biltong vs. Commercial Beef Jerky</h2>
      <p class="text-slate-dark/70 text-sm sm:text-base">Why ambient air-curing creates a completely different biological and culinary product compared to industrial heat-treated beef snacks.</p>
    </div>

    <div class="overflow-x-auto rounded-micro border border-brand-border shadow-card bg-parchment/30">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-brand-border bg-slate-dark text-parchment text-xs uppercase tracking-wider">
            <th scope="col" class="py-4 px-6 font-semibold w-1/4">Craft Comparison</th>
            <th scope="col" class="py-4 px-6 font-bold text-white bg-paprika/90 w-3/8 text-sm">
              <span class="flex items-center gap-2">
                <svg class="w-4 h-4 text-amber-300" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                Biltong Bites (Authentic Air-Cure)
              </span>
            </th>
            <th scope="col" class="py-4 px-6 font-semibold text-gray-400 bg-slate-dark w-3/8">Commercial Beef Jerky</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-brand-border text-sm">
          
          <tr class="hover:bg-white/60 transition-colors">
            <td class="py-4 px-6 font-bold text-slate-dark">Heat Exposure</td>
            <td class="py-4 px-6 font-medium text-emerald-900 bg-emerald-50/40 border-x border-brand-border">
              <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span><strong class="text-slate-dark">Zero Heat</strong> (Slow Ambient Airflow over days)</span>
              </div>
            </td>
            <td class="py-4 px-6 text-slate-dark/70">
              Cooked in Industrial Dehydration Ovens (&gt;70°C)
            </td>
          </tr>

          <tr class="hover:bg-white/60 transition-colors">
            <td class="py-4 px-6 font-bold text-slate-dark">Added Sugars &amp; Syrups</td>
            <td class="py-4 px-6 font-medium text-emerald-900 bg-emerald-50/40 border-x border-brand-border">
              <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span><strong class="text-slate-dark">0.0g Sugar</strong> (Sugar-Free, Keto Certified)</span>
              </div>
            </td>
            <td class="py-4 px-6 text-rose-900 font-medium">
              High Fructose Corn Syrup, Brown Sugar &amp; Molasses (Up to 15g sugar/100g)
            </td>
          </tr>

          <tr class="hover:bg-white/60 transition-colors">
            <td class="py-4 px-6 font-bold text-slate-dark">Protein Density</td>
            <td class="py-4 px-6 font-medium text-emerald-900 bg-emerald-50/40 border-x border-brand-border">
              <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span><strong class="text-slate-dark">50g - 65g per 100g</strong> (Bioavailable pure fuel)</span>
              </div>
            </td>
            <td class="py-4 px-6 text-slate-dark/70">
              25g - 32g per 100g (Diluted with liquid marinades &amp; fillers)
            </td>
          </tr>

          <tr class="hover:bg-white/60 transition-colors">
            <td class="py-4 px-6 font-bold text-slate-dark">Texture Profile</td>
            <td class="py-4 px-6 font-medium text-emerald-900 bg-emerald-50/40 border-x border-brand-border">
              <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span><strong class="text-slate-dark">Tender, marbled steak ribbons</strong> that melt naturally</span>
              </div>
            </td>
            <td class="py-4 px-6 text-slate-dark/70">
              Tough, rubbery, dehydrated sheets requiring heavy chewing
            </td>
          </tr>

          <tr class="hover:bg-white/60 transition-colors">
            <td class="py-4 px-6 font-bold text-slate-dark">Preservatives &amp; Cures</td>
            <td class="py-4 px-6 font-medium text-emerald-900 bg-emerald-50/40 border-x border-brand-border">
              <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Malt vinegar, coarse sea salt, cracked coriander seeds</span>
              </div>
            </td>
            <td class="py-4 px-6 text-slate-dark/70">
              Sodium nitrates, liquid smoke, artificial MSG &amp; preservatives
            </td>
          </tr>

        </tbody>
      </table>
    </div>

  </div>
</section>

<!-- ========================================================================= -->
<!-- F. PRODUCT DETAIL PAGE (PDP) INTERACTIVE PURCHASE ENGINE                  -->
<!-- ========================================================================= -->
<section id="pdp-interactive" class="py-16 md:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
  <div class="mb-8">
    <span class="text-xs font-bold uppercase tracking-widest text-olive">Flagship Artisanal Cut</span>
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-dark">Product Detail Purchasing Engine</h2>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 bg-white p-6 sm:p-10 rounded-micro border border-brand-border shadow-card">
    
    <div class="lg:col-span-6 flex flex-col space-y-6">
      <div class="relative w-full aspect-square rounded-micro overflow-hidden bg-[#241512] border border-brand-border flex items-center justify-center p-8">
        <svg class="w-full h-full" viewBox="0 0 400 400" fill="none">
          <rect width="400" height="400" fill="#1C1412"/>
          <path d="M60 120 C 120 70, 280 60, 340 110 C 370 200, 350 310, 310 350 C 200 380, 100 350, 60 300 Z" fill="#581F1A" stroke="#3D120E" stroke-width="4"/>
          <path d="M60 120 C 120 70, 280 60, 340 110 C 370 200, 350 310, 310 350" stroke="#CBB179" stroke-width="6" stroke-linecap="round" stroke-dasharray="10 12"/>
          <path d="M120 160 Q 220 190 280 150" stroke="#F4EDE4" stroke-width="6" stroke-linecap="round" opacity="0.8"/>
          <path d="M100 240 Q 210 270 300 220" stroke="#F4EDE4" stroke-width="7" stroke-linecap="round" opacity="0.75"/>
          <path d="M140 290 Q 230 310 270 280" stroke="#F4EDE4" stroke-width="5" stroke-linecap="round" opacity="0.7"/>
          <circle cx="170" cy="180" r="4.5" fill="#D4AF37"/>
          <circle cx="210" cy="200" r="4" fill="#E8DEC8"/>
          <circle cx="240" cy="170" r="5" fill="#C59B27"/>
          <circle cx="190" cy="250" r="4" fill="#D4AF37"/>
        </svg>
        <div class="absolute bottom-4 left-4 bg-slate-dark/90 text-white backdrop-blur text-xs px-3 py-1 rounded-micro font-medium border border-white/10">
          Current Selection: <span id="pdp-visual-spec" class="text-amber-300 font-bold">250g • Traditional Marbling • Moist</span>
        </div>
      </div>

      <div class="grid grid-cols-4 gap-2 text-center">
        <div class="bg-parchment p-2.5 rounded-micro border border-brand-border">
          <span class="block text-base sm:text-lg font-extrabold text-slate-dark">52g</span>
