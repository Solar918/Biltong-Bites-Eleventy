---
layout: layouts/base.njk
title: Handcrafted Tender Biltong
description: Artisanal, nutrient-dense biltong hand-made in Auckland using low-stress New Zealand beef for superior tenderness and less acidity.
---

<!-- ========================================================================= -->
<!-- HERO SECTION                                                              -->
<!-- ========================================================================= -->
<section class="relative overflow-hidden pt-12 pb-16 md:pt-20 md:pb-24 border-b border-brand-border bg-gradient-to-b from-brand-surface-raised to-parchment">
  <div class="absolute -right-20 -top-20 w-96 h-96 rounded-full bg-paprika/5 blur-3xl pointer-events-none"></div>
  <div class="absolute -left-20 bottom-0 w-80 h-80 rounded-full bg-olive/5 blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-center">
      
      <!-- Left Column -->
      <div class="lg:col-span-6 xl:col-span-7 flex flex-col justify-center">
        
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-micro bg-olive/10 border border-olive/20 text-olive text-xs font-semibold tracking-wider uppercase mb-5 w-fit">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>100% NZ Crafted Beef Biltong • Young Enterprise Scheme</span>
        </div>

        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-dark leading-[1.12] mb-6">
          Handcrafted. Tender. <br><span class="text-paprika">Biltong Bites.</span>
        </h1>

        <p class="text-base sm:text-lg text-slate-dark/80 leading-relaxed max-w-xl mb-8">
          Artisanal, nutrient-dense biltong hand-made in Auckland using low-stress beef for superior tenderness and less natural acidity. Quality you can taste in every single bite.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-8">
          <a href="#products" class="inline-flex justify-center items-center px-8 py-4 bg-paprika hover:bg-paprika-hover text-white font-medium text-base rounded-micro shadow-card transition-all duration-200 text-center">
            Shop Our Range
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
          <a href="#about" class="inline-flex justify-center items-center px-7 py-4 bg-transparent hover:bg-white text-slate-dark border border-slate-dark font-medium text-base rounded-micro transition-all duration-200 text-center">
            Our Story
          </a>
        </div>

        <div class="inline-flex items-center gap-3 p-3 bg-brand-surface rounded-micro border border-brand-border w-fit shadow-subtle">
          <div class="flex text-amber-500">
            ★★★★★
          </div>
          <div class="text-xs font-semibold text-slate-dark">
            <span>Handcrafted in Auckland by Student Entrepreneurs</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Real Product Showcase Image -->
      <div class="lg:col-span-6 xl:col-span-5">
        <div class="relative rounded-micro border border-brand-border bg-brand-surface p-3 shadow-card overflow-hidden">
          
          <div class="relative w-full aspect-[4/3] rounded-micro overflow-hidden bg-parchment flex items-center justify-center">
            <img src="/assets/images/100og.jpeg" alt="Handcrafted Biltong Bites pack" class="w-full h-full object-cover" />

            <div class="absolute top-4 left-4 bg-slate-dark/90 text-white backdrop-blur px-3 py-1.5 rounded-micro text-xs font-semibold tracking-wide border border-white/10 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-paprika"></span>
              Fresh Air-Cured Batch
            </div>
            <div class="absolute bottom-4 right-4 bg-brand-surface text-slate-dark px-3 py-1.5 rounded-micro text-xs font-bold border border-brand-border shadow-sm max-w-[85%] text-right truncate">
              Original Toasted Coriander &amp; Pepper
            </div>
          </div>

          <div class="mt-3 p-3 bg-parchment rounded-micro border border-brand-border flex items-center justify-between text-xs">
            <div class="flex items-center gap-2">
              <span class="font-bold text-slate-dark">Source:</span>
              <span class="text-slate-dark/70">100% NZ Pasture-Fed Beef</span>
            </div>
            <div class="text-olive font-semibold flex items-center gap-1">
              Low-Stress Meat Tenderization
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<!-- ========================================================================= -->
<!-- VALUE PROPOSITIONS STRIP                                                 -->
<!-- ========================================================================= -->
<section class="bg-brand-surface border-b border-brand-border py-8" id="craft">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 lg:gap-8">
      
      <div class="flex items-start gap-4 p-4 rounded-micro bg-brand-surface-raised border border-brand-border/70">
        <div class="w-10 h-10 rounded-micro bg-olive/10 text-olive flex items-center justify-center flex-shrink-0 font-bold">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
        <div>
          <h2 class="text-sm font-bold text-slate-dark mb-1">High Natural Protein</h2>
          <p class="text-xs text-slate-dark/70 leading-relaxed">Dense, bioavailable protein in every tender piece with zero cheap fillers.</p>
        </div>
      </div>

      <div class="flex items-start gap-4 p-4 rounded-micro bg-brand-surface-raised border border-brand-border/70">
        <div class="w-10 h-10 rounded-micro bg-paprika/10 text-paprika flex items-center justify-center flex-shrink-0 font-bold">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
          </svg>
        </div>
        <div>
          <h2 class="text-sm font-bold text-slate-dark mb-1">Low-Stress NZ Beef</h2>
          <p class="text-xs text-slate-dark/70 leading-relaxed">Animals raised with less stress, delivering superior natural tenderness and significantly less acidity.</p>
        </div>
      </div>

      <div class="flex items-start gap-4 p-4 rounded-micro bg-brand-surface-raised border border-brand-border/70">
        <div class="w-10 h-10 rounded-micro bg-slate-dark/10 text-slate-dark flex items-center justify-center flex-shrink-0 font-bold">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div>
          <h2 class="text-sm font-bold text-slate-dark mb-1">Artisanal Small Batches</h2>
          <p class="text-xs text-slate-dark/70 leading-relaxed">Tumbled in roasted coriander, cracked black pepper, sea salt, and vinegar. Slowly air-dried with ambient air.</p>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ========================================================================= -->
<!-- PRODUCTS COLLECTION GRID                                                  -->
<!-- ========================================================================= -->
<section id="products" class="py-16 md:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
  <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-10 gap-4">
    <div>
      <div class="text-xs font-bold uppercase tracking-widest text-olive mb-2">Our Range</div>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-dark">Handcrafted Pack Sizes</h2>
      <p class="text-slate-dark/70 text-sm mt-1">Choose your pack size, freshly spiced and naturally cured.</p>
    </div>

    <!-- Search & Sort Controls -->
    <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
      <div class="relative flex-1 md:w-64">
        <input id="product-search" type="search" placeholder="Search pack sizes..." class="w-full bg-brand-surface text-slate-dark border border-brand-border px-3.5 py-2 rounded-micro text-xs focus:outline-none focus:border-paprika shadow-sm" />
      </div>

      <select id="product-sort" class="bg-brand-surface border border-brand-border px-3 py-2 rounded-micro text-xs font-medium text-slate-dark focus:outline-none focus:border-paprika shadow-sm">
        <option value="default">Sort: Default</option>
        <option value="popularity">Popularity (Best Sellers)</option>
        <option value="price-asc">Price: Low to High</option>
        <option value="price-desc">Price: High to Low</option>
      </select>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8" id="product-grid">
    {% for product in collections.products %}
      {% include "components/product-card.njk" %}
    {% endfor %}
  </div>

  <div id="no-products-message" class="hidden text-center py-12 bg-brand-surface rounded-micro border border-brand-border mt-8">
    <p class="font-serif text-lg text-slate-dark mb-2">No matching products found</p>
    <button type="button" id="clear-filters-btn" class="text-xs font-bold text-paprika underline">Clear search filter</button>
  </div>
</section>

<!-- ========================================================================= -->
<!-- EDUCATIONAL COMPARISON TABLE                                              -->
<!-- ========================================================================= -->
<section id="comparison-table" class="py-16 md:py-20 bg-brand-surface border-y border-brand-border">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-xs font-bold uppercase tracking-widest text-paprika mb-2 block">Uncompromising Nutrition</span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-dark mb-4">Biltong vs. Commercial Beef Jerky</h2>
      <p class="text-slate-dark/70 text-sm sm:text-base">Why ambient air-curing creates a completely different biological and culinary product compared to industrial heat-treated beef snacks.</p>
    </div>

    <div class="overflow-x-auto rounded-micro border border-brand-border shadow-card bg-brand-surface-raised">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-brand-border bg-brand-surface-raised text-slate-dark text-xs uppercase tracking-wider">
            <th scope="col" class="py-4 px-6 font-semibold w-1/4">Comparison</th>
            <th scope="col" class="py-4 px-6 font-bold text-white bg-paprika w-3/8 text-sm">
              Biltong Bites (Authentic Air-Cure)
            </th>
            <th scope="col" class="py-4 px-6 font-semibold text-slate-dark/70 w-3/8">Commercial Jerky</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-brand-border text-sm">
          
          <tr class="hover:bg-brand-surface/60 transition-colors">
            <td class="py-4 px-6 font-bold text-slate-dark">Meat Source</td>
            <td class="py-4 px-6 font-medium text-emerald-800 dark:text-emerald-400 bg-emerald-500/10 border-x border-brand-border">
              <strong>100% NZ Low-Stress Beef</strong> (Higher tenderness &amp; low acidity)
            </td>
            <td class="py-4 px-6 text-slate-dark/70">
              Bulk commodity beef from industrial lots
            </td>
          </tr>

          <tr class="hover:bg-brand-surface/60 transition-colors">
            <td class="py-4 px-6 font-bold text-slate-dark">Heat Exposure</td>
            <td class="py-4 px-6 font-medium text-emerald-800 dark:text-emerald-400 bg-emerald-500/10 border-x border-brand-border">
              <strong>Zero Heat</strong> (Air-dried with natural ambient airflow)
            </td>
            <td class="py-4 px-6 text-slate-dark/70">
              Cooked in commercial dehydration ovens (&gt;70°C)
            </td>
          </tr>

          <tr class="hover:bg-brand-surface/60 transition-colors">
            <td class="py-4 px-6 font-bold text-slate-dark">Texture &amp; Chew</td>
            <td class="py-4 px-6 font-medium text-emerald-800 dark:text-emerald-400 bg-emerald-500/10 border-x border-brand-border">
              <strong>Tender, rich steak slices</strong> that melt naturally
            </td>
            <td class="py-4 px-6 text-slate-dark/70">
              Tough, rubbery, dehydrated sheets
            </td>
          </tr>

          <tr class="hover:bg-brand-surface/60 transition-colors">
            <td class="py-4 px-6 font-bold text-slate-dark">Ingredients</td>
            <td class="py-4 px-6 font-medium text-emerald-800 dark:text-emerald-400 bg-emerald-500/10 border-x border-brand-border">
              <strong>Clean pantry ingredients</strong> (Coriander, pepper, sea salt, vinegar)
            </td>
            <td class="py-4 px-6 text-slate-dark/70">
              Corn syrups, artificial smoke flavorings, nitrates &amp; MSG
            </td>
          </tr>

        </tbody>
      </table>
    </div>

  </div>
</section>

<!-- ========================================================================= -->
<!-- ABOUT SECTION (OUR STORY)                                                 -->
<!-- ========================================================================= -->
<section id="about" class="py-16 md:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="bg-brand-surface rounded-micro border border-brand-border p-8 sm:p-12 shadow-card">
    <div class="max-w-3xl">
      <div class="text-xs font-bold uppercase tracking-widest text-olive mb-2">Young Enterprise Scheme</div>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-dark mb-6">Our Story</h2>
      
      <div class="space-y-4 text-sm sm:text-base text-slate-dark/80 leading-relaxed">
        <p>
          We’re a team of four passionate 15 and 16-year-old student founders from <strong>Long Bay College in Auckland</strong> running <strong>Biltong Bites</strong> as part of the Young Enterprise Scheme (YES).
        </p>
        <p>
          Unlike mass-produced jerky, we handcraft our biltong using carefully selected, low-stress meat. This thoughtful curing method yields pieces that are naturally more tender, less acidic, and richer in wholesome flavor.
        </p>
        <p>
          Driven by teamwork, passion, and high standards, we take pride in delivering a clean, high-protein snack made right here by the next generation of Kiwi entrepreneurs.
        </p>
      </div>

      <div class="grid grid-cols-3 gap-4 mt-8 pt-8 border-t border-brand-border text-center">
        <div class="p-3 bg-brand-surface-raised rounded-micro">
          <span class="block text-2xl font-extrabold text-slate-dark">4</span>
          <span class="text-xs font-semibold text-slate-dark/60">Student Founders</span>
        </div>
        <div class="p-3 bg-brand-surface-raised rounded-micro">
          <span class="block text-2xl font-extrabold text-slate-dark">100%</span>
          <span class="text-xs font-semibold text-slate-dark/60">NZ Handcrafted</span>
        </div>
        <div class="p-3 bg-brand-surface-raised rounded-micro">
          <span class="block text-2xl font-extrabold text-slate-dark">High</span>
          <span class="text-xs font-semibold text-slate-dark/60">Natural Protein</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ========================================================================= -->
<!-- CONTACT & PICKUP INFO                                                     -->
<!-- ========================================================================= -->
<section id="contact" class="py-16 bg-brand-surface border-t border-brand-border">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
      
      <div class="md:col-span-5 space-y-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-olive mb-1 block">Auckland Pickup &amp; Orders</span>
          <h2 class="font-serif text-3xl font-bold text-slate-dark">Get in Touch</h2>
        </div>
        <p class="text-xs sm:text-sm text-slate-dark/70 leading-relaxed">
          Have questions about bulk orders, school pickups, or our curing process? We'd love to hear from you!
        </p>
        <div class="p-4 bg-brand-surface-raised rounded-micro border border-brand-border space-y-2 text-xs">
          <div>
            <strong>Direct Email:</strong><br>
            <a href="mailto:{{ site.author.email }}" class="text-paprika hover:underline">{{ site.author.email }}</a>
          </div>
          <div>
            <strong>Pickup Location:</strong><br>
            <span>{{ site.pickup }}</span>
          </div>
        </div>
      </div>

      <div class="md:col-span-7 bg-brand-surface-raised p-6 sm:p-8 rounded-micro border border-brand-border">
        <form id="contact-form" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-dark mb-1">Your Name</label>
              <input required name="name" type="text" placeholder="e.g. John Doe" class="w-full bg-brand-surface text-slate-dark border border-brand-border px-3.5 py-2.5 text-xs rounded-micro focus:outline-none focus:border-paprika" />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-dark mb-1">Your Email</label>
              <input required type="email" name="email" placeholder="e.g. john@example.com" class="w-full bg-brand-surface text-slate-dark border border-brand-border px-3.5 py-2.5 text-xs rounded-micro focus:outline-none focus:border-paprika" />
            </div>
          </div>
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-dark mb-1">Message</label>
            <textarea required name="message" rows="4" placeholder="How can we help you?" class="w-full bg-brand-surface text-slate-dark border border-brand-border px-3.5 py-2.5 text-xs rounded-micro focus:outline-none focus:border-paprika"></textarea>
          </div>
          <button type="submit" class="w-full sm:w-auto px-8 py-3 bg-slate-dark hover:bg-paprika text-parchment hover:text-white text-xs font-bold uppercase tracking-wider rounded-micro transition">
            Send Message
          </button>
          <div id="contact-result" class="text-xs font-semibold mt-2"></div>
        </form>
      </div>

    </div>
  </div>
</section>
