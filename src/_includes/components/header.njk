<header class="sticky top-0 z-40 bg-[var(--surface)]/95 backdrop-blur-md border-b border-brand-border shadow-subtle transition-all duration-300">
  <!-- Top Announcement Bar -->
  <aside class="bg-[#121212] text-[#F9F6F0] py-2 px-4 text-xs font-medium tracking-wide border-b border-white/5">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="hidden md:flex items-center space-x-2 text-[11px] text-gray-300">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <span>Young Enterprise Scheme • Hand-Crafted in Auckland, NZ</span>
      </div>
      
      <!-- Rotating Announcement Text -->
      <div class="w-full md:w-auto text-center overflow-hidden flex-1 md:px-8">
        <div id="announcement-track" class="transition-opacity duration-300">
          <span id="announcement-text" class="inline-block font-medium">Free Pickup at Long Bay College • 100% NZ Low-Stress Beef</span>
        </div>
      </div>

      <div class="hidden md:flex items-center space-x-4 text-[11px] text-gray-300">
        <span class="text-amber-300 font-semibold tracking-wider">HIGH PROTEIN</span>
        <span>|</span>
        <a href="/#about" class="hover:text-white transition">Our Story</a>
      </div>
    </div>
  </aside>

  <!-- Main Navigation Header -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Mobile Menu Trigger -->
      <div class="flex items-center lg:hidden">
        <button id="mobile-menu-btn" type="button" aria-label="Open mobile menu" class="p-2 text-[var(--text)] hover:text-paprika focus:outline-none">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>

      <!-- Brand Wordmark & Artisan Badge -->
      <div class="flex-shrink-0 flex flex-col justify-center">
        <a href="/" class="group flex items-center gap-3">
          <div class="w-10 h-10 rounded-micro bg-[var(--surface-raised)] text-[var(--text)] flex items-center justify-center font-serif text-xl font-bold border border-brand-border shadow-sm group-hover:border-paprika transition">
            BB
          </div>
          <div>
            <span class="block font-serif text-2xl font-bold tracking-tight text-[var(--text)] group-hover:text-paprika transition">BILTONG BITES</span>
            <span class="block text-[10px] tracking-widest uppercase font-semibold text-olive">100% NZ Crafted Beef Biltong</span>
          </div>
        </a>
      </div>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center space-x-7 text-sm font-medium text-[var(--text)]/90">
        <a href="/#products" class="hover:text-paprika transition py-1 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-paprika hover:after:w-full after:transition-all">Our Products</a>
        <a href="/#craft" class="hover:text-paprika transition py-1 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-paprika hover:after:w-full after:transition-all">The Curing Craft</a>
        <a href="/#comparison-table" class="hover:text-paprika transition py-1 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-paprika hover:after:w-full after:transition-all">Biltong vs. Jerky</a>
        <a href="/#about" class="hover:text-paprika transition py-1 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-paprika hover:after:w-full after:transition-all">Our Story</a>
        <a href="/#contact" class="hover:text-paprika transition py-1 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-paprika hover:after:w-full after:transition-all">Contact</a>
      </nav>

      <!-- Utility Icons, Theme Toggle & Cart Trigger -->
      <div class="flex items-center space-x-3 sm:space-x-4">
        <!-- Theme Toggle Button -->
        <button id="theme-toggle" type="button" class="p-2 text-[var(--text)] hover:text-paprika transition rounded-micro focus:outline-none" aria-label="Toggle theme" title="Toggle theme">
          <span class="theme-toggle-icon text-base">🌙</span>
        </button>

        <a href="/account/" aria-label="Customer Account" class="p-2 text-[var(--text)] hover:text-paprika transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
        </a>

        <!-- Cart Trigger Button with Counter Badge -->
        <button id="cart-drawer-trigger" type="button" class="relative inline-flex items-center gap-2 bg-[var(--surface-raised)] text-[var(--text)] hover:bg-paprika hover:text-white transition px-4 py-2 rounded-micro font-medium text-xs sm:text-sm tracking-wide border border-brand-border shadow-sm group">
          <svg class="w-4 h-4 text-inherit group-hover:scale-105 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
          </svg>
          <span>Cart</span>
          <span id="cart-badge-count" class="cart-count inline-flex items-center justify-center bg-paprika text-white text-xs font-bold rounded-full w-5 h-5 ml-0.5 transition">0</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-brand-border bg-[var(--surface)] px-4 pt-3 pb-6 space-y-3">
    <a href="/#products" class="block text-base font-medium py-2 border-b border-brand-border/40 hover:text-paprika">Our Products</a>
    <a href="/#craft" class="block text-base font-medium py-2 border-b border-brand-border/40 hover:text-paprika">The Curing Craft</a>
    <a href="/#comparison-table" class="block text-base font-medium py-2 border-b border-brand-border/40 hover:text-paprika">Biltong vs. Jerky</a>
    <a href="/#about" class="block text-base font-medium py-2 border-b border-brand-border/40 hover:text-paprika">Our Story</a>
    <a href="/#contact" class="block text-base font-medium py-2 border-b border-brand-border/40 hover:text-paprika">Contact</a>
    <a href="/account/" class="block text-base font-medium py-2 hover:text-paprika">Customer Account</a>
    <div class="pt-2 flex flex-wrap gap-2 text-xs text-[var(--muted)]">
      <span>{{ site.author.email }}</span>
      <span>•</span>
      <span>{{ site.pickup }}</span>
    </div>
  </div>
</header>
