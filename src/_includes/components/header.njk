<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-brand-border shadow-subtle transition-all duration-300">
  <!-- Top Announcement Bar -->
  <aside class="bg-slate-dark text-[#F9F6F0] py-2 px-4 text-xs font-medium tracking-wide">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="hidden md:flex items-center space-x-2 text-[11px] text-gray-300">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <span>Artisanal Batch No. 104 • Fresh Air-Curing Today</span>
      </div>
      
      <!-- Rotating Announcement Text -->
      <div class="w-full md:w-auto text-center overflow-hidden flex-1 md:px-8">
        <div id="announcement-track" class="transition-opacity duration-300">
          <span id="announcement-text" class="inline-block font-medium">Free UK &amp; International Shipping on Orders Over £50</span>
        </div>
      </div>

      <div class="hidden md:flex items-center space-x-4 text-[11px] text-gray-300">
        <span class="text-amber-300 font-semibold tracking-wider">GLATT KOSHER</span>
        <span>|</span>
        <a href="/#kosher-standard" class="hover:text-white transition">London Beth Din Supervised</a>
      </div>
    </div>
  </aside>

  <!-- Main Navigation Header -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Mobile Menu Trigger -->
      <div class="flex items-center lg:hidden">
        <button id="mobile-menu-btn" type="button" aria-label="Open mobile menu" class="p-2 text-slate-dark hover:text-paprika focus:outline-none">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>

      <!-- Brand Wordmark & Artisan Butcher Badge -->
      <div class="flex-shrink-0 flex flex-col justify-center">
        <a href="/" class="group flex items-center gap-3">
          <div class="w-10 h-10 rounded-micro bg-slate-dark text-parchment flex items-center justify-center font-serif text-xl font-bold border border-brand-border shadow-sm group-hover:border-paprika transition">
            BB
          </div>
          <div>
            <span class="block font-serif text-2xl font-bold tracking-tight text-slate-dark group-hover:text-paprika transition">BILTONG BITES</span>
            <span class="block text-[10px] tracking-widest uppercase font-semibold text-olive">Est. South African Tradition</span>
          </div>
        </a>
      </div>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center space-x-7 text-sm font-medium text-slate-dark/90">
        <a href="/#products-collection" class="hover:text-paprika transition py-1 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-paprika hover:after:w-full after:transition-all">Sliced Biltong</a>
        <a href="/#products-collection" class="hover:text-paprika transition py-1 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-paprika hover:after:w-full after:transition-all">Droëwors &amp; Sticks</a>
        <a href="/#products-collection" class="hover:text-paprika transition py-1 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-paprika hover:after:w-full after:transition-all">Fresh Boerewors</a>
        <a href="/#pdp-interactive" class="hover:text-paprika transition py-1 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-paprika hover:after:w-full after:transition-all">Taster Packs</a>
        <a href="/#comparison-table" class="hover:text-paprika transition py-1 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-paprika hover:after:w-full after:transition-all">The Curing Craft</a>
        <a href="/#kosher-standard" class="hover:text-paprika transition py-1 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-paprika hover:after:w-full after:transition-all">Kosher Standard</a>
      </nav>

      <!-- Utility Icons & Cart Trigger -->
      <div class="flex items-center space-x-4 sm:space-x-5">
        <a href="/#products-collection" aria-label="Search products" class="p-2 text-slate-dark hover:text-paprika transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </a>

        <a href="/account/" aria-label="Customer Account" class="hidden sm:inline-flex p-2 text-slate-dark hover:text-paprika transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
        </a>

        <!-- Cart Trigger Button with Counter Badge -->
        <button id="cart-drawer-trigger" type="button" class="relative inline-flex items-center gap-2 bg-slate-dark text-parchment hover:bg-paprika transition px-4 py-2 rounded-micro font-medium text-xs sm:text-sm tracking-wide shadow-sm group">
          <svg class="w-4 h-4 text-parchment group-hover:scale-105 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
          </svg>
          <span>Cart</span>
          <span id="cart-badge-count" class="cart-count inline-flex items-center justify-center bg-paprika group-hover:bg-white group-hover:text-paprika text-white text-xs font-bold rounded-full w-5 h-5 ml-0.5 transition">0</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-brand-border bg-white px-4 pt-3 pb-6 space-y-3">
    <a href="/#products-collection" class="block text-base font-medium py-2 border-b border-brand-border/40 hover:text-paprika">Sliced Biltong</a>
    <a href="/#products-collection" class="block text-base font-medium py-2 border-b border-brand-border/40 hover:text-paprika">Droëwors &amp; Sticks</a>
    <a href="/#products-collection" class="block text-base font-medium py-2 border-b border-brand-border/40 hover:text-paprika">Fresh Boerewors</a>
    <a href="/#pdp-interactive" class="block text-base font-medium py-2 border-b border-brand-border/40 hover:text-paprika">Taster Packs</a>
    <a href="/#comparison-table" class="block text-base font-medium py-2 border-b border-brand-border/40 hover:text-paprika">The Curing Craft</a>
    <a href="/#kosher-standard" class="block text-base font-medium py-2 border-b border-brand-border/40 hover:text-paprika">Kosher Standard</a>
    <a href="/account/" class="block text-base font-medium py-2 hover:text-paprika">Customer Account</a>
    <div class="pt-2 flex flex-wrap gap-2 text-xs text-stone-500">
      <span>{{ site.author.email }}</span>
      <span>•</span>
      <span>{{ site.phone }}</span>
    </div>
  </div>
</header>
