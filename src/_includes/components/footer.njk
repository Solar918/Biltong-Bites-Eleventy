      <!-- Col 2: Navigation -->
      <div class="lg:col-span-2 space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-amber-300">Charcuterie</h4>
        <ul class="space-y-2 text-xs text-gray-300">
          <li><a href="/#products-collection" class="hover:text-white transition">Traditional Sliced Biltong</a></li>
          <li><a href="/#products-collection" class="hover:text-white transition">Droëwors Sticks</a></li>
          <li><a href="/#products-collection" class="hover:text-white transition">Boerewors Spiral</a></li>
          <li><a href="/#pdp-interactive" class="hover:text-white transition">Custom Taster Boxes</a></li>
          <li><a href="/#pdp-interactive" class="hover:text-white transition">Subscribe &amp; Save (15% Off)</a></li>
        </ul>
      </div>

      <!-- Col 3: Compliance & Kosher -->
      <div class="lg:col-span-3 space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-amber-300">Compliance &amp; Standards</h4>
        <ul class="space-y-2 text-xs text-gray-300">
          <li><a href="/#kosher-standard" class="hover:text-white transition">Rabbinical Kosher Certificate (PDF)</a></li>
          <li><a href="/#pdp-interactive" class="hover:text-white transition">Allergen &amp; Dietary Directory</a></li>
          <li><a href="/cart/" class="hover:text-white transition">Cold-Chain Shipping Policy</a></li>
          <li><a href="/checkout/" class="hover:text-white transition">Terms of Service</a></li>
          <li><a href="/account/" class="hover:text-white transition">Privacy &amp; Data Security</a></li>
        </ul>
      </div>

      <!-- Col 4: Newsletter "Join the Braai Club" -->
      <div class="lg:col-span-3 space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-amber-300">Join the Braai Club</h4>
        <p class="text-xs text-gray-300 leading-relaxed">
          Subscribe for 10% off your first cured meat order, private batch alerts, and authentic South African recipes.
        </p>
        <form onsubmit="handleNewsletterSubmit(event)" class="space-y-2">
          <div class="flex">
            <input type="email" required placeholder="Enter your email address" class="w-full bg-stone-900 border border-brand-border/30 px-3 py-2 text-xs text-white placeholder-gray-500 rounded-l-micro focus:outline-none focus:border-paprika">
            <button type="submit" class="bg-paprika hover:bg-paprika-hover px-4 text-xs font-bold uppercase rounded-r-micro transition">Join</button>
          </div>
          <p id="newsletter-feedback" class="text-[10px] text-emerald-400 hidden">Welcome to the Braai Club! Check your inbox for code BRAAI10.</p>
        </form>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-400 gap-4">
      <p>© 2026 {{ site.name }}. All Rights Reserved. Not affiliated with industrial jerky mass processors.</p>
      <div class="flex items-center space-x-4 text-xs">
        <span>100% Pasture-Raised</span>
        <span>•</span>
        <span>Zero Sugar</span>
        <span>•</span>
        <span>Glatt Kosher Supervised</span>
      </div>
