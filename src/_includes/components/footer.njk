<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <span class="footer-logo">{{ site.name }}</span>
      <p class="footer-desc">Crafted with pride by young Kiwi entrepreneurs under the Young Enterprise Scheme.</p>
    </div>

    <div class="footer-links">
      <ul class="footer-nav">
        <li><a href="/#products">Products</a></li>
        <li><a href="/#about">About Us</a></li>
        <li><a href="/#contact">Contact</a></li>
        <li><a href="/cart/">Cart</a></li>
      </ul>
    </div>

    <div class="footer-meta">
      <p class="copyright">© <span data-year></span> {{ site.name }}. All rights reserved.</p>
      {% if site.author.github %}
        <p class="footer-sub"><a href="https://github.com/{{ site.author.github }}" target="_blank" rel="noopener noreferrer">View on GitHub</a></p>
      {% endif %}
    </div>
  </div>
</footer>
