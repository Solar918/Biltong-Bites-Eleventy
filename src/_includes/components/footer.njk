    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 pb-12 border-b border-white/10">
      
      <!-- Col 1: Remediated Contact Block -->
      <div class="lg:col-span-4 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-micro bg-paprika text-white flex items-center justify-center font-serif font-bold text-base">
            BB
          </div>
          <div>
            <span class="block font-serif text-xl font-bold tracking-tight text-white">BILTONG BITES</span>
            <span class="block text-[9px] tracking-widest uppercase font-semibold text-amber-300">Certified Artisanal Butchery</span>
          </div>
        </div>

        <p class="text-xs text-gray-300 leading-relaxed max-w-sm">
          Crafted strictly to time-honored South African air-curing methods. 
          No heat dehydration ovens, zero added sugar, certified Glatt Kosher.
        </p>

        <div class="text-xs space-y-2 text-gray-300 pt-2">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-paprika flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <a href="mailto:{{ site.author.email }}" class="hover:text-white transition">{{ site.author.email }}</a>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-paprika flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <a href="tel:{{ site.phone | replace(' ', '') }}" class="hover:text-white transition">{{ site.phone }}</a>
