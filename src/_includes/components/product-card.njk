<div class="bg-white rounded-micro border border-brand-border shadow-card hover:shadow-lg transition-all duration-200 flex flex-col justify-between overflow-hidden group product"
     data-title="{{ product.data.title | lower }}"
     data-desc="{{ (product.data.description or '') | lower }}"
     data-flavour="{{ (product.data.flavour or []).join(' ').toLowerCase() }}"
     data-quantity="{{ (product.data.quantity or []).join(' ').toLowerCase() }}"
     data-price="{{ product.data.price or 0 }}"
     data-weight="{{ product.data.weight or 0 }}"
     data-popularity="{{ product.data.popularity or 0 }}">
  <div>
    <!-- High-Contrast Visual Container -->
    <div class="relative bg-[#231512] h-60 w-full overflow-hidden flex items-center justify-center p-6 border-b border-brand-border">
      <div class="absolute top-3 left-3 flex flex-col gap-1.5 z-10">
        {% if product.data.popularity >= 4 %}
          <span class="bg-paprika text-white text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-micro shadow-sm">Best Seller</span>
        {% else %}
          <span class="bg-olive text-white text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-micro shadow-sm">Air-Cured</span>
        {% endif %}
        <span class="bg-slate-dark/90 text-parchment text-[10px] font-semibold tracking-wider px-2 py-0.5 rounded-micro border border-white/10">52g Protein</span>
      </div>

      <div class="w-full h-full flex flex-col items-center justify-center relative transform group-hover:scale-105 transition-transform duration-300">
        {% if product.data.image %}
          <img loading="lazy" src="{{ product.data.image }}" alt="{{ product.data.title }}" class="w-full h-full object-cover rounded-micro" />
        {% else %}
          <svg class="w-48 h-32" viewBox="0 0 200 120" fill="none">
            <path d="M20 70 C 40 40, 160 30, 180 65 C 160 95, 50 100, 20 70 Z" fill="#6E231C" stroke="#3D120E" stroke-width="3"/>
            <path d="M35 65 C 55 45, 145 40, 165 62" stroke="#FAF2EB" stroke-width="3" stroke-dasharray="8 4"/>
            <circle cx="90" cy="55" r="2.5" fill="#D4AF37"/>
            <circle cx="110" cy="70" r="3" fill="#D4AF37"/>
            <circle cx="70" cy="75" r="2" fill="#EAE5D9"/>
            <circle cx="135" cy="58" r="2.5" fill="#C59B27"/>
          </svg>
        {% endif %}
      </div>
    </div>

    <!-- Details -->
    <div class="p-5">
      <div class="flex justify-between items-baseline mb-2">
        <h3 class="font-serif text-lg font-bold text-slate-dark group-hover:text-paprika transition">
          <a href="{{ product.url }}">{{ product.data.title }}</a>
        </h3>
        <span class="text-base font-bold text-slate-dark">£{{ product.data.price | default('7.70') }}</span>
      </div>
      <p class="text-xs text-slate-dark/70 mb-4 leading-relaxed line-clamp-2">
        {{ product.data.description }}
      </p>

      <div class="bg-parchment rounded-micro p-2.5 border border-brand-border mb-4">
        <span class="block text-[11px] font-bold text-slate-dark mb-1">Choose Moisture:</span>
        <div class="flex gap-1.5 text-xs">
          <span class="px-2 py-0.5 rounded-micro bg-white border border-slate-dark/30 text-slate-dark font-medium">Moist</span>
          <span class="px-2 py-0.5 rounded-micro bg-white border border-brand-border text-slate-dark/70">Traditional</span>
          <span class="px-2 py-0.5 rounded-micro bg-white border border-brand-border text-slate-dark/70">Dry</span>
        </div>
      </div>
    </div>
  </div>

  <div class="p-5 pt-0 flex gap-2">
    <a href="{{ product.url }}" class="w-1/3 py-2.5 px-2 bg-transparent hover:bg-parchment text-slate-dark border border-brand-border rounded-micro text-xs font-semibold text-center transition-colors">
      Details
    </a>
    <button type="button" onclick="quickAddToCart('{{ product.data.title }}', {{ product.data.price or 7.70 }})" class="w-2/3 py-2.5 px-3 bg-slate-dark hover:bg-paprika text-white rounded-micro text-xs font-semibold tracking-wider uppercase transition-colors flex items-center justify-center gap-1.5">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
      </svg>
      Quick Add
    </button>
  </div>
</div>
