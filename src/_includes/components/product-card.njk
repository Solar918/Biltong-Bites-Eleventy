<div class="bg-brand-surface rounded-micro border border-brand-border shadow-card hover:shadow-lg transition-all duration-200 flex flex-col justify-between overflow-hidden group product"
     data-title="{{ product.data.title | lower }}"
     data-desc="{{ (product.data.description or '') | lower }}"
     data-flavour="{{ (product.data.flavour or []) | join(' ') | lower }}"
     data-quantity="{{ (product.data.quantity or []) | join(' ') | lower }}"
     data-price="{{ product.data.price or 0 }}"
     data-weight="{{ product.data.weight or 0 }}"
     data-popularity="{{ product.data.popularity or 0 }}">
  <div>
    <!-- Visual Container with Real Image -->
    <div class="relative bg-brand-surface-raised h-64 w-full overflow-hidden flex items-center justify-center p-3 border-b border-brand-border">
      <div class="absolute top-3 left-3 flex flex-col gap-1.5 z-10">
        {% if product.data.popularity >= 4 %}
          <span class="bg-paprika text-white text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-micro shadow-sm">★ Best Seller</span>
        {% else %}
          <span class="bg-olive text-white text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-micro shadow-sm">100% NZ Beef</span>
        {% endif %}
        <span class="bg-slate-dark/90 text-parchment text-[10px] font-semibold tracking-wider px-2 py-0.5 rounded-micro border border-white/10">High Protein</span>
      </div>

      <a href="{{ product.url }}" class="w-full h-full flex items-center justify-center overflow-hidden rounded-micro">
        {% if product.data.image %}
          <img loading="lazy" src="{{ product.data.image }}" alt="{{ product.data.title }}" class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-300" />
        {% else %}
          <img loading="lazy" src="/assets/images/placeholder.svg" alt="{{ product.data.title }}" class="w-full h-full object-contain" />
        {% endif %}
      </a>
    </div>

    <!-- Details -->
    <div class="p-5">
      <div class="flex justify-between items-baseline mb-2">
        <h3 class="font-serif text-lg font-bold text-slate-dark group-hover:text-paprika transition">
          <a href="{{ product.url }}">{{ product.data.title }}</a>
        </h3>
        <span class="text-base font-bold text-slate-dark">${{ product.data.price | default('0') }}</span>
      </div>
      <p class="text-xs text-slate-dark/70 mb-4 leading-relaxed line-clamp-2">
        {{ product.data.description }}
      </p>

      <div class="bg-brand-surface-raised rounded-micro p-2.5 border border-brand-border mb-4 flex items-center justify-between text-xs">
        <span class="font-bold text-slate-dark">Pack Size:</span>
        <span class="px-2 py-0.5 rounded-micro bg-brand-surface border border-brand-border text-slate-dark font-semibold">
          {{ product.data.quantity[0] or 'Standard' }}
        </span>
      </div>
    </div>
  </div>

  <div class="p-5 pt-0 flex gap-2">
    <a href="{{ product.url }}" class="w-1/3 py-2.5 px-2 bg-transparent hover:bg-brand-surface-raised text-slate-dark border border-brand-border rounded-micro text-xs font-semibold text-center transition-colors">
      Details
    </a>
    <button type="button" onclick="quickAddToCart('{{ product.data.title }}', {{ product.data.price or 0 }})" class="w-2/3 py-2.5 px-3 bg-slate-dark hover:bg-paprika text-parchment hover:text-white rounded-micro text-xs font-semibold tracking-wider uppercase transition-colors flex items-center justify-center gap-1.5">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
      </svg>
      Quick Add (${{ product.data.price or 0 }})
    </button>
  </div>
</div>
