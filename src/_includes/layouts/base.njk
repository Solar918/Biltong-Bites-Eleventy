<!doctype html>
<html lang="en" class="scroll-smooth no-js" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title or page.title or site.name }} · {{ site.title }}</title>
    <meta name="description" content="{{ description or page.description or site.description }}" />

    <meta property="og:title" content="{{ title or page.title or site.name }}" />
    <meta property="og:description" content="{{ description or page.description or site.description }}" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:image" content="{{ site.url }}/assets/images/100og.jpeg" />

    <meta name="twitter:card" content="summary_large_image" />

    <!-- Google Fonts: Playfair Display & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        darkMode: ['class', '[data-theme="dark"]'],
        theme: {
          extend: {
            colors: {
              parchment: 'var(--bg)',
              'brand-surface': 'var(--surface)',
              'brand-surface-raised': 'var(--surface-raised)',
              'brand-midnight': '#140e0c',
              'slate-dark': 'var(--text)',
              paprika: 'var(--primary)',
              'paprika-hover': 'var(--primary-hover)',
              olive: 'var(--accent)',
              'olive-hover': 'var(--primary)',
              'brand-border': 'var(--border)'
            },
            fontFamily: {
              serif: ['"Playfair Display"', 'Georgia', 'serif'],
              sans: ['"Plus Jakarta Sans"', '-apple-system', 'BlinkMacSystemFont', 'sans-serif']
            },
            borderRadius: {
              'micro': '6px'
            },
            boxShadow: {
              'subtle': '0 2px 10px rgba(0, 0, 0, 0.05)',
              'card': '0 4px 20px -2px rgba(0, 0, 0, 0.08)'
            }
          }
        }
      };
    </script>

    <!-- Main Stylesheet for Auth, Account, Admin & Components -->
    <link rel="stylesheet" href="/assets/styles/main.css?v=5" />

    <script>
      // Theme boot: check localStorage first, else sync with system default
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          let theme = stored;
          if (!theme) {
            const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            theme = systemPrefersDark ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', theme);
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
          document.documentElement.classList.remove('no-js');
        } catch (_e) {}
      })();
    </script>

    <style>
      body {
        background-color: var(--bg);
        color: var(--text);
        font-family: 'Plus Jakarta Sans', sans-serif;
        -webkit-font-smoothing: antialiased;
        transition: background-color 0.25s ease, color 0.25s ease;
      }
      .font-serif {
        font-family: 'Playfair Display', Georgia, serif;
      }
      ::-webkit-scrollbar { width: 8px; }
      ::-webkit-scrollbar-track { background: var(--bg); }
      ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
      ::-webkit-scrollbar-thumb:hover { background: var(--muted); }

      .cart-drawer-backdrop {
        transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s;
      }
      .cart-drawer-panel {
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      }
    </style>
  </head>
  <body class="antialiased min-h-screen flex flex-col selection:bg-paprika selection:text-white">
    <a class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:p-3 focus:bg-paprika focus:text-white focus:rounded-micro" href="#main">Skip to content</a>
    
    {% include "components/header.njk" %}

    <main id="main" tabindex="-1" class="flex-1">
      {{ content | safe }}
    </main>

    {% include "components/cart-drawer.njk" %}
    {% include "components/footer.njk" %}

    <script defer src="/assets/scripts/main.js"></script>
  </body>
</html>
