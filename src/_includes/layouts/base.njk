<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title or page.title or site.name }} · {{ site.title }}</title>
    <meta name="description" content="{{ description or page.description or site.description }}" />

    <meta property="og:title" content="{{ title or page.title or site.name }}" />
    <meta property="og:description" content="{{ description or page.description or site.description }}" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:image" content="{{ site.url }}/assets/images/100og.jpeg" />

    <meta name="twitter:card" content="summary_large_image" />

    <!-- Google Fonts: Playfair Display & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              parchment: '#F9F6F0',
              'slate-dark': '#121212',
              paprika: '#A83A2A',
              'paprika-hover': '#8E2F21',
              olive: '#4A5335',
              'olive-hover': '#3D452B',
              'brand-border': '#E5E0D8'
            },
            fontFamily: {
              serif: ['"Playfair Display"', 'Georgia', 'serif'],
              sans: ['"Plus Jakarta Sans"', '-apple-system', 'BlinkMacSystemFont', 'sans-serif']
            },
            borderRadius: {
              'micro': '5px'
            },
            boxShadow: {
              'subtle': '0 2px 10px rgba(18, 18, 18, 0.04)',
              'card': '0 4px 20px -2px rgba(18, 18, 18, 0.06)'
            }
          }
        }
      };
    </script>

    <style>
      body {
        background-color: #F9F6F0;
        color: #121212;
        font-family: 'Plus Jakarta Sans', sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      .font-serif {
        font-family: 'Playfair Display', Georgia, serif;
      }
      ::-webkit-scrollbar { width: 8px; }
      ::-webkit-scrollbar-track { background: #F9F6F0; }
      ::-webkit-scrollbar-thumb { background: #D8D2C5; border-radius: 4px; }
      ::-webkit-scrollbar-thumb:hover { background: #B8B0A0; }

      .cart-drawer-backdrop {
        transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s;
      }
      .cart-drawer-panel {
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      }
    </style>
  </head>
  <body class="bg-parchment text-slate-dark antialiased min-h-screen flex flex-col selection:bg-paprika selection:text-white">
    <a class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:p-3 focus:bg-paprika focus:text-white focus:rounded-micro" href="#main">Skip to content</a>
    
    {% include "components/header.njk" %}

    <main id="main" tabindex="-1" class="flex-1">
      {{ content | safe }}
    </main>

    {% include "components/cart-drawer.njk" %}
    {% include "components/footer.njk" %}

    <script defer src="/assets/scripts/main.js"></script>
  </body>
</html>
