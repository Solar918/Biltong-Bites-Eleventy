---
layout: layouts/base.njk
title: "{{ title }}"
description: "{{ description }}"
---

<article class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
  <div class="mb-6">
    <a href="/#products" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-dark/70 hover:text-paprika transition">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
      Back to All Products
    </a>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 bg-white p-6 sm:p-10 rounded-micro border border-brand-border shadow-card">
    
    <!-- Left: Product Image & Badges -->
    <div class="lg:col-span-6 flex flex-col space-y-6">
      <div class="relative w-full aspect-square rounded-micro overflow-hidden bg-parchment border border-brand-border flex items-center justify-center p-4">
        {% if image %}
          <img src="{{ image }}" alt="{{ title }}" class="w-full h-full object-cover rounded-micro" />
        {% else %}
          <img src="/assets/images/100og.jpeg" alt="{{ title }}" class="w-full h-full object-cover rounded-micro" />
        {% endif %}
        <div class="absolute bottom-4 left-4 bg-slate-dark/90 text-white backdrop-blur text-xs px-3 py-1 rounded-micro font-medium border border-white/10">
          Selection: <span class="text-amber-300 font-bold">{{ title }}</span>
        </div>
      </div>

      <div class="grid grid-cols-3 gap-2 text-center">
        <div class="bg-parchment p-2.5 rounded-micro border border-brand-border">
          <span class="block text-base sm:text-lg font-extrabold text-slate-dark">100%</span>
          <span class="text-[10px] uppercase font-bold text-slate-dark/60 tracking-wider">NZ Prime Beef</span>
        </div>
        <div class="bg-parchment p-2.5 rounded-micro border border-brand-border">
          <span class="block text-base sm:text-lg font-extrabold text-slate-dark">High</span>
          <span class="text-[10px] uppercase font-bold text-slate-dark/60 tracking-wider">Clean Protein</span>
        </div>
        <div class="bg-parchment p-2.5 rounded-micro border border-brand-border">
          <span class="block text-base sm:text-lg font-extrabold text-slate-dark">Low</span>
          <span class="text-[10px] uppercase font-bold text-slate-dark/60 tracking-wider">Stress Meat</span>
        </div>
      </div>
    </div>

    <!-- Right: PDP Options & Purchase Controls -->
    <div class="lg:col-span-6 flex flex-col justify-between">
      <div>
        <div class="flex flex-wrap gap-2 mb-3">
          <span class="px-2.5 py-1 rounded-micro text-xs font-bold bg-paprika/10 text-paprika border border-paprika/20">High Protein</span>
          <span class="px-2.5 py-1 rounded-micro text-xs font-bold bg-olive/10 text-olive border border-olive/20">Zero Additives</span>
          <span class="px-2.5 py-1 rounded-micro text-xs font-bold bg-slate-dark/10 text-slate-dark border border-slate-dark/20">100% NZ Beef</span>
        </div>

        <h1 class="font-serif text-3xl sm:text-4xl font-bold text-slate-dark mb-2">
          {{ title }}
        </h1>
        
        <p class="text-sm text-slate-dark/80 mb-6 leading-relaxed">
          {{ description }}
        </p>

        <div class="flex items-baseline gap-3 mb-6 pb-6 border-b border-brand-border">
          <span id="pdp-calculated-price" class="text-3xl font-extrabold text-slate-dark">${{ price }}</span>
          <span class="text-xs text-slate-dark/60">NZD per pack</span>
        </div>

        <!-- Quantity & Pack Size Selector -->
        <div class="space-y-5">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-dark mb-2">
              Available Pack Sizes:
            </label>
            <div class="flex flex-wrap gap-2">
              <a href="/products/product-50og/" class="px-3.5 py-2 border {% if quantity[0] == '50g' %}border-2 border-paprika bg-paprika/5 font-bold{% else %}border-brand-border bg-white{% endif %} text-slate-dark text-xs rounded-micro transition hover:border-slate-dark">
                50g ($5.00)
              </a>
              <a href="/products/product-100og/" class="px-3.5 py-2 border {% if quantity[0] == '100g' %}border-2 border-paprika bg-paprika/5 font-bold{% else %}border-brand-border bg-white{% endif %} text-slate-dark text-xs rounded-micro transition hover:border-slate-dark">
                100g ($8.00)
              </a>
              <a href="/products/product-250og/" class="px-3.5 py-2 border {% if quantity[0] == '250g' %}border-2 border-paprika bg-paprika/5 font-bold{% else %}border-brand-border bg-white{% endif %} text-slate-dark text-xs rounded-micro transition hover:border-slate-dark">
                250g ($15.00)
              </a>
              <a href="/products/product-500og/" class="px-3.5 py-2 border {% if quantity[0] == '500g' %}border-2 border-paprika bg-paprika/5 font-bold{% else %}border-brand-border bg-white{% endif %} text-slate-dark text-xs rounded-micro transition hover:border-slate-dark">
                500g ($25.00)
              </a>
              <a href="/products/product-1000og/" class="px-3.5 py-2 border {% if quantity[0] == '1kg' %}border-2 border-paprika bg-paprika/5 font-bold{% else %}border-brand-border bg-white{% endif %} text-slate-dark text-xs rounded-micro transition hover:border-slate-dark">
                1kg ($50.00)
              </a>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-dark mb-2">
              Select Quantity:
            </label>
            <div class="flex items-center gap-3">
              <div class="flex items-center border border-brand-border rounded-micro bg-parchment">
                <button type="button" id="pdp-minus" class="px-3 py-2 text-sm text-slate-dark hover:bg-brand-border transition">−</button>
                <input type="number" id="pdp-qty" value="1" min="1" max="99" class="w-12 text-center bg-transparent text-xs font-bold text-slate-dark focus:outline-none" />
                <button type="button" id="pdp-plus" class="px-3 py-2 text-sm text-slate-dark hover:bg-brand-border transition">+</button>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-8 space-y-3">
          <button id="pdp-add-to-cart-btn" type="button" onclick="addCurrentProductToBag()" class="w-full py-4 bg-paprika hover:bg-paprika-hover text-white font-bold text-base rounded-micro shadow-card transition-all flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
            </svg>
            <span>Add to Cart • <span id="cta-button-price">${{ price }}</span></span>
          </button>

          <div class="grid grid-cols-2 gap-2 text-center text-[11px] text-slate-dark/80 pt-1">
            <div class="flex items-center justify-center gap-1.5 p-2 bg-parchment rounded-micro border border-brand-border">
              <svg class="w-4 h-4 text-olive" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Long Bay College Pickup</span>
            </div>
            <div class="flex items-center justify-center gap-1.5 p-2 bg-parchment rounded-micro border border-brand-border">
              <svg class="w-4 h-4 text-olive" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span>Fresh Batch Curing</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Accordions -->
      <div class="mt-10 border-t border-brand-border divide-y divide-brand-border text-sm">
        <div class="accordion-item py-3">
          <button type="button" class="accordion-toggle w-full flex justify-between items-center font-bold text-left text-slate-dark hover:text-paprika transition focus:outline-none" aria-expanded="false">
            <span>Ingredients &amp; Curing Method</span>
            <svg class="w-4 h-4 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div class="accordion-content hidden pt-3 text-xs text-slate-dark/80 leading-relaxed space-y-2">
            <p><strong>Ingredients:</strong> 100% NZ Grass-Fed Beef, Vinegar, Sea Salt, Cracked Roasted Coriander, Black Pepper, Brown Sugar, Spices.</p>
            <p>Hand-cured using meat sourced from low-stress raised cattle for superior tenderness and less natural acidity. Slowly air-dried with natural airflow—never heat dehydrated.</p>
          </div>
        </div>

        <div class="accordion-item py-3">
          <button type="button" class="accordion-toggle w-full flex justify-between items-center font-bold text-left text-slate-dark hover:text-paprika transition focus:outline-none" aria-expanded="false">
            <span>Storage Guidelines</span>
            <svg class="w-4 h-4 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div class="accordion-content hidden pt-3 text-xs text-slate-dark/80 leading-relaxed space-y-2">
            <p>Store in a cool, dry pantry away from direct sunlight. Once opened, keep refrigerated and consume within 5 days for optimal flavor and texture.</p>
          </div>
        </div>
      </div>
    </div>

  </div>
</article>

<script>
  const basePrice = {{ price or 0 }};
  const title = "{{ title }}";
  const qtyInput = document.getElementById('pdp-qty');
  const minusBtn = document.getElementById('pdp-minus');
  const plusBtn = document.getElementById('pdp-plus');
  const priceDisplay = document.getElementById('pdp-calculated-price');
  const ctaPrice = document.getElementById('cta-button-price');

  function updatePrice() {
    let q = parseInt(qtyInput.value, 10) || 1;
    if (q < 1) q = 1;
    qtyInput.value = q;
    const total = (basePrice * q).toFixed(2);
    if (priceDisplay) priceDisplay.textContent = `$${total}`;
    if (ctaPrice) ctaPrice.textContent = `$${total}`;
  }

  if (minusBtn && plusBtn && qtyInput) {
    minusBtn.addEventListener('click', () => {
      let q = parseInt(qtyInput.value, 10) || 1;
      if (q > 1) { qtyInput.value = q - 1; updatePrice(); }
    });
    plusBtn.addEventListener('click', () => {
      let q = parseInt(qtyInput.value, 10) || 1;
      qtyInput.value = q + 1;
      updatePrice();
    });
    qtyInput.addEventListener('change', updatePrice);
  }

  function addCurrentProductToBag() {
    const q = parseInt(qtyInput ? qtyInput.value : 1, 10) || 1;
    const cart = getCart();
    const existing = cart.find(i => (i.title || i.name) === title);
    const now = Date.now();

    if (existing) {
      existing.quantity = (existing.quantity || 1) + q;
      existing.timestamp = now;
    } else {
      cart.push({
        id: 'prod_' + now,
        title: title,
        variant: '{{ quantity[0] or "Standard" }} Pack',
        price: basePrice,
        quantity: q,
        timestamp: now
      });
    }
    saveCart(cart);
    openCartDrawer();
  }
</script>
