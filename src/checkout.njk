---
layout: layouts/base.njk
title: Checkout & Payment Details
description: Complete your details to receive payment instructions for your Biltong Bites order.
---

<article class="container checkout-page">
  <header class="checkout-page-header">
    <h1>Complete Your Order</h1>
    <p class="checkout-subtitle">Enter your contact details below to reserve your handcrafted biltong.</p>
  </header>

  <div class="checkout-grid">
    <!-- Form Side -->
    <div class="checkout-form-card">
      <h2>1. Contact & Pickup Details</h2>
      <form id="checkout-form">
        <div class="form-row">
          <label for="name">
            <span>First and Last Name</span>
            <input type="text" id="name" name="name" required placeholder="e.g. John Doe" autocomplete="name" />
          </label>
          <label for="phone">
            <span>Mobile Phone Number</span>
            <input type="tel" id="phone" name="phone" required placeholder="e.g. 021 000 0000" autocomplete="tel" />
          </label>
        </div>

        <label for="email">
          <span>Email Address (for order confirmation & bank transfer details)</span>
          <input type="email" id="email" name="email" required placeholder="e.g. john@example.com" autocomplete="email" />
        </label>

        <div class="checkout-pickup-notice">
          <strong>📍 Pickup Location:</strong>
          <p>Orders are fulfilled at Long Bay College, Auckland. You will receive an email confirmation with bank details to complete payment.</p>
        </div>

        <button type="submit" class="btn btn-primary btn-block" id="place-order-btn">
          Place Order & Receive Payment Info
        </button>
      </form>
      <div id="email-preview" class="email-preview"></div>
    </div>

    <!-- Summary Side -->
    <div class="checkout-summary-card">
      <h2>2. Order Summary</h2>
      <div id="checkout-order-items" class="checkout-items-list">
        <!-- Dynamically rendered -->
      </div>
      <div class="checkout-total-row">
        <span>Total Due:</span>
        <span id="checkout-total-amount">$0.00</span>
      </div>
      <a href="/cart/" class="btn btn-ghost btn-block" style="margin-top: 1.5rem;">Edit Cart</a>
    </div>
  </div>
</article>
